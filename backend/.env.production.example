# Production environment variables for Railway deployment
# These are the environment variables you need to set in Railway dashboard

# PostgreSQL connection string (Your Neon database URL)
DATABASE_URL=postgresql://neondb_owner:npg_iyx7o2JrDzLB@ep-calm-frog-ahhhx11i-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT configuration - IMPORTANT: Generate a strong random secret!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Server (Railway auto-assigns PORT, you don't need to set it)
# PORT is automatically set by Railway
NODE_ENV=production

# Frontend URL (will be updated after deploying frontend)
CLIENT_URL=https://your-frontend-url.vercel.app

# Password reset + email (Optional - configure if using email features)
APP_BASE_URL=https://your-frontend-url.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM_NAME=SaveMate
MAIL_FROM_EMAIL=no-reply@savemate.app
RESET_TOKEN_EXPIRY_MINUTES=60
